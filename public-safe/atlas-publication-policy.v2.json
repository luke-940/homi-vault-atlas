{
  "schema": "atlas.publication_policy.v2",
  "version": "2026-07-28",
  "mode": "actual_safe_names",
  "publicRoots": [
    "MOC",
    "Papers",
    "Signals",
    "Rocket",
    "Groot",
    "Intelligence Layer"
  ],
  "ownerAdditionalRoots": [
    "Research"
  ],
  "conditionalRoots": {
    "Strategy": {
      "admitKinds": [
        "strategy_insight"
      ],
      "requiresResolvedReferenceToPrimaryRoot": true
    }
  },
  "excludedPathSegments": [
    "Archive",
    "Backups",
    "Templates",
    "Console",
    "Daily",
    "vault-backups"
  ],
  "excludedBasenames": [
    "AGENTS",
    "GROOT_HANDOFF",
    "_Index"
  ],
  "excludedTitlePatterns": [
    "\\bcontrol[ _-]?tower\\b",
    "\\bhandoff\\b",
    "\\breceipt\\b",
    "\\bwork[ _-]?order\\b",
    "\\bowner[ _-]?lease\\b",
    "\\bagent[ _-]?control[ _-]?plane\\b",
    "\\bowner[ _-]?charter\\b",
    "\\bsession[ _-]?topology\\b",
    "\\bactivity[ _-]?(?:event|registry|index)\\b",
    "\\bbatch\\b",
    "\\bcursor\\b"
  ],
  "display": {
    "stripLeadingStrategyCode": true,
    "stripLeadingBracketNumber": true,
    "indexDocumentsBecomeDomainMetadata": true,
    "fallbackAliases": false
  },
  "forbiddenRuntimeFields": [
    "body",
    "frontmatter",
    "relativePath",
    "sourcePath",
    "sourceHash",
    "receipt",
    "workOrder",
    "batch",
    "cursor"
  ],
  "reconciliation": {
    "requireUnclassifiedZero": true,
    "aggregateMode": "none"
  }
}
