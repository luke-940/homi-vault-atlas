{
  "name": "homi-vault-atlas",
  "version": "7.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "architecture": "node scripts/check-architecture.mjs",
    "lint": "node scripts/lint-source-contract.mjs && npm run architecture",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "npm run test:public",
    "test:public": "vitest run tests-public --maxWorkers=1",
    "test:gate1": "ATLAS_GATE1_SLICE=true ATLAS_TEST_DATA_DIR=.generated/profiles/public/data vitest run tests-public/data-boundary-contract.test.ts tests-public/knowledge-shard-contract.test.ts tests-public/knowledge-audit-contract.test.ts --maxWorkers=1",
    "profiles:gate1": "node scripts/project-gate1.mjs",
    "build": "node scripts/build-public-site.mjs",
    "build:gate1": "npm run profiles:gate1 && ATLAS_GATE1_SLICE=true ATLAS_PUBLIC_DATA_DIR=.generated/profiles/public/data ATLAS_PUBLIC_OUTPUT_DIR=dist-gate1 node scripts/build-public-site.mjs",
    "build:owner": "node scripts/build-owner-site.mjs",
    "audit": "node scripts/audit-public-bundle.mjs",
    "audit:gate1": "ATLAS_GATE1_SLICE=true ATLAS_PUBLIC_DATA_DIR=.generated/profiles/public/data ATLAS_PUBLIC_OUTPUT_DIR=dist-gate1 ATLAS_PUBLIC_AUDIT_RECEIPT=artifacts/gate1/publication-audit.json node scripts/audit-public-bundle.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run audit",
    "verify:gate1": "npm run lint && npm run typecheck && npm run build:gate1 && npm run test:gate1 && npm run audit:gate1 && npm run qa:gate1",
    "release:package": "node scripts/package-release-artifact.mjs",
    "release:verify": "node scripts/package-release-artifact.mjs --verify",
    "release:readback": "node scripts/readback-production.mjs",
    "qa:local": "node scripts/run-local-qa.mjs",
    "qa:gate1": "ATLAS_GATE1_SLICE=true ATLAS_PUBLIC_OUTPUT_DIR=dist-gate1 ATLAS_PUBLIC_AUDIT_RECEIPT=artifacts/gate1/publication-audit.json ATLAS_LOCAL_QA_RECEIPT=artifacts/gate1/local-qa.json node scripts/run-local-qa.mjs",
    "qa:ci": "npx --no-install playwright test --config=playwright.config.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.185.1",
    "d3-force": "^3.0.0",
    "esbuild": "^0.28.1",
    "lightningcss": "1.32.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
